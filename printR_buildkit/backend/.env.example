# Backend env (local)
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Use Supabase Postgres (authoritative in production)
# DATABASE_URL=postgresql://...

# Local SQLite fallback for dev (ignored when DATABASE_URL is set)
DATABASE_PATH=./data/printr.sqlite

# Stripe (test mode recommended for local)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_SUCCESS_URL=http://localhost:5173/printr/store?status=success
STRIPE_CANCEL_URL=http://localhost:5173/printr/store?status=cancel

# Session resume / play tokens
PLAY_TOKEN_TTL_MS=3600000
SESSION_RESUME_GRACE_MS=600000

# Admin token for protected ops endpoints (DO NOT expose client-side)
ADMIN_TOKEN=change_me_local_dev

# Switchboard VRF (server-authoritative)
# USE_SWITCHBOARD_VRF=true
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_COMMITMENT=confirmed
# SOLANA_PAYER_SECRETKEY_BASE58=base58_secret
# SOLANA_PAYER_KEYPAIR_PATH=/path/to/id.json
# SWITCHBOARD_QUEUE_PUBKEY=
# SOLANA_EXPLORER_CLUSTER=mainnet-beta
